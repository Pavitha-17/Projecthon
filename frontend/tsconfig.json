{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx,src/**/*", "src/navigation/**/*"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./src/navigation"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
}
